# Supabase project (Settings → API)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Analytics / crash reporting — both optional; SDKs stay dormant when empty.
EXPO_PUBLIC_POSTHOG_KEY=
# Sentry: only EXPO_PUBLIC_-prefixed vars reach the app bundle at runtime.
EXPO_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
