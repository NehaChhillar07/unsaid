# supabase project (public — safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# server-only. NEVER expose to the client. used by /admin (service-role reads/writes).
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# optional — reserved for signed admin cookies if we move off supabase-session gating
ADMIN_COOKIE_SECRET=

# canonical site url, used for OG metadata + magic-link redirects in emails
NEXT_PUBLIC_SITE_URL=https://unsaid.app
